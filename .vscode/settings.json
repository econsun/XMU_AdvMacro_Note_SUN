{
    "latex-workshop.latex.recipes": [
        {
            "name": "make all (XeLaTeX + SyncTeX)",
            "tools": ["make-all"]
        },
        {
            "name": "XeLaTeX once (current file)",
            "tools": ["xelatex-once-current"]
        },
        {
            "name": "XeLaTeX poster (once)",
            "tools": ["xelatex-once-current"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "make-all",
            "command": "make",
            "cwd": "%WORKSPACE_FOLDER%",
            "args": ["all"]
        },
        {
            "name": "xelatex-once-current",
            "command": "python3",
            "cwd": "%DIR%",
            "args": [
                "%WORKSPACE_FOLDER%/_tools/latex-current.py",
                "--passes",
                "1",
                "%DOCFILE_EXT%"
            ]
        }
    ],
    "latex-workshop.latex.build.enableMagicComments": true,
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.autoBuild.run": "onSave",
    // 整书与单章统一进入 _build/book，确保 View PDF 与实际输出路径一致。
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/_build/book",
    // 直接解析通过 \input 载入的 _config/setting-cmds.tex，不维护补全 JSON。
    "latex-workshop.latex.texDirs": [
        "%WORKSPACE_FOLDER%",
        "%WORKSPACE_FOLDER%/_config"
    ],
    "latex-workshop.intellisense.update.aggressive.enabled": true,
    "latex-workshop.intellisense.update.delay": 300,
    "latex-workshop.intellisense.package.enabled": true,
    // 接受命令补全后，使用 Tab 依次跳转各参数占位符。
    "editor.tabCompletion": "on",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "latex-workshop.synctex.afterBuild.enabled": true,
    // 输入反斜杠或命令名称时自动显示 LaTeX 候选；也可随时按 Ctrl+Space。
    "[latex]": {
        "editor.suggestOnTriggerCharacters": true,
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "on"
        }
    },
    "files.exclude": {
        ".DS_Store": true,
        "missfont.log": true,
        "**/*.aux": true,
        "**/*.bbl": true,
        "**/*.bcf": true,
        "**/*.blg": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/*.run.xml": true,
        "**/*.synctex.gz": true,
        "**/*.toc": true,
        "**/*.xdv": true,
        "**/*.bbl-SAVE-ERROR": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        ".gitignore": true,
        "LICENSE": true,
        ".venv": true,
        "_archive": true,
        "_tools": true,
        "Makefile": true,
        "*.bib": true,
        "README.md": true
    },
    "search.exclude": {
        ".DS_Store": true,
        "missfont.log": true,
        "_build": true,
        "_archive": true,
        "**/*.aux": true,
        "_tools": true,
        "**/*.bbl": true,
        "**/*.bcf": true,
        "**/*.blg": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/*.run.xml": true,
        "**/*.synctex.gz": true,
        "**/*.toc": true,
        "**/*.xdv": true,
        ".venv": true,
        "**/*.bbl-SAVE-ERROR": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "sections/**/*.pdf": true,
        ".gitignore": false,
        "LICENSE": false,
        "Makefile": false,
        "*.bib": false,
        "README.md": false
    }
}
